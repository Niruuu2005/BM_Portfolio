VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI backend base URL.
# Vercel Services (same domain): use /api
VITE_API_URL=/api
# Local direct backend (uvicorn in /api): uncomment the next line instead.
# VITE_API_URL=http://localhost:8000

# Server-side only - never commit real values. Used by: node scripts/create-supabase-admin.mjs
# Dashboard -> Settings -> API -> service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for npm run create-admin (defaults: nirruu20@bm-portfolio.org / 200605)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=