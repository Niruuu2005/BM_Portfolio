# Supabase Postgres connection string (direct or pooler)
DATABASE_URL=

# Supabase JWT Secret (Dashboard -> Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=

# Comma-separated explicit allowed origins
# Local example: http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional regex for dynamic preview origins (example for Vercel previews)
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$
CORS_ORIGIN_REGEX=