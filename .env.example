# Copy to `.env` at this repo root (same folder as `vercel.json`).
# This is the single source of truth for local frontend + backend config.
# Never commit `.env`. On Vercel, set the same keys in Project Settings → Environment Variables.

# --- Frontend (Vite; only VITE_* are exposed to the browser) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI base URL. Same-origin deploy: `/api`. Local: Vite proxies `/api` to FastAPI (see API_PORT).
VITE_API_URL=/api
# Port FastAPI listens on (same as uvicorn / api/run-dev.ps1). Vite uses http://127.0.0.1:<API_PORT> unless VITE_DEV_API_PROXY is set.
API_PORT=8001
# Optional: full proxy URL (overrides API_PORT).
# VITE_DEV_API_PROXY=http://127.0.0.1:8000
# If port 8000 is busy (WinError 10013): set API_PORT=8001 and run uvicorn on 8001.

# --- Backend (FastAPI; server-only) ---
# Supabase → Project Settings → Database → URI (use pooler or direct; include password).
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Scripts (npm run create-admins in frontend/) — server-only ---
SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN2_EMAIL=
# ADMIN2_PASSWORD=
