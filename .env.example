# Copy to `.env` at this repo root (same folder as `vercel.json`).
# FastAPI also reads `frontend/.env` and `api/.env` if present (for legacy setups).
# Never commit `.env`. On Vercel, set the same keys in Project Settings → Environment Variables.

# --- Frontend (Vite; only VITE_* are exposed to the browser) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI base URL. Same-origin deploy: `/api`. Local: `/api` is proxied by Vite to uvicorn (see VITE_DEV_API_PROXY).
VITE_API_URL=/api
# Where `npm run dev` proxies `/api` (FastAPI). Override if the API runs elsewhere.
# VITE_DEV_API_PROXY=http://127.0.0.1:8000

# --- Backend (FastAPI; server-only) ---
# Supabase → Project Settings → Database → URI (use pooler or direct; include password).
# Example: postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Scripts (npm run create-admins in frontend/) — server-only ---
SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN2_EMAIL=
# ADMIN2_PASSWORD=
