# Copy to `.env` at this repo root (same folder as `vercel.json`).
# One file for: Vite frontend, FastAPI (`api/`), and Node scripts (`frontend/scripts/`).
# Never commit `.env`. On Vercel, set the same keys in Project Settings → Environment Variables.

# --- Frontend (Vite; only VITE_* are exposed to the browser) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# FastAPI base URL. Same-origin deploy: `/api`. Local uvicorn: `http://localhost:8000/api`
VITE_API_URL=/api

# --- Backend (FastAPI; server-only) ---
DATABASE_URL=
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# CORS_ORIGIN_REGEX=^https://.*\.vercel\.app$

# --- Scripts (e.g. npm run create-admins in frontend/) — server-only ---
SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN2_EMAIL=
# ADMIN2_PASSWORD=
